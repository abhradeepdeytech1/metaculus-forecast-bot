# Environment variable reference for GitHub Actions.
# The application reads process variables. It does not load .env files.

# Required secrets.
METACULUS_TOKEN=
ANTHROPIC_API_KEY=

# Optional provider secrets. OpenRouter is only used for configured OpenRouter model IDs.
OPENROUTER_API_KEY=
# AskNews is optional. Set the API key or both OAuth values to add news research.
ASKNEWS_API_KEY=
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=

# Non-secret GitHub Actions variables. Defaults shown below.
TOURNAMENT_IDS=fall-futureeval-2026,minibench
FORECAST_MODELS=claude-sonnet-5-5,claude-opus-5-5
MODEL_SAMPLE_COUNTS=4,2
# Optional fallback for custom model lists when MODEL_SAMPLE_COUNTS is unset. Leave unset for the default mix.
# SAMPLES_PER_MODEL=2
MAX_OUTPUT_TOKENS=4096
QUESTION_BUDGET_USD=1
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=200
ANTHROPIC_PRICES_JSON=
ASKNEWS_REQUEST_COST_USD=0
PROBABILITY_FLOOR=0.02






